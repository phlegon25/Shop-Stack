APP_NAME=ShopStack
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://ShopStack.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ------------------------------------------------------------------
# Security: password hashing (Argon2id is the platform default)
# ------------------------------------------------------------------
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1
# Bcrypt is available as a fallback driver.
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------
# Platform
# ------------------------------------------------------------------
PLATFORM_NAME=ShopStack
PLATFORM_CURRENCY=GHS
TRIAL_DAYS=14

# Token / session lifetimes
TENANT_TOKEN_HOURS=12
TENANT_REMEMBER_DAYS=30
SUPER_ADMIN_TOKEN_HOURS=8
IMPERSONATION_MINUTES=60

# ------------------------------------------------------------------
# Database (production: MySQL or PostgreSQL with a least-privilege user)
# For local development SQLite also works: DB_CONNECTION=sqlite and
# create database/database.sqlite
# ------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# NEVER commit a real password. Inject at deploy time.
DB_PASSWORD=

# ------------------------------------------------------------------
# Cache / Queue / Sessions / Mail
# ------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# Initial Super Admin bootstrap (used by SuperAdminSeeder ON FIRST
# DEPLOY ONLY). 2FA enrollment is mandatory on first login regardless.
# ------------------------------------------------------------------
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ------------------------------------------------------------------
# Sanctum
# ------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=
